# ─── SERVER ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── DATABASE ─────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/studycafe

# ─── JWT SECRETS — change these to long random strings! ───────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_to_a_very_long_random_secret_min_64_chars_xxxxxxxxxxxxx
JWT_REFRESH_SECRET=CHANGE_THIS_to_a_different_long_random_secret_min_64_chars_xxx

# ─── CORS ─────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000
